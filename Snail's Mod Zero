//★ 자동 구매

const autoClickAllButtons = () => {

    // Floating Notification 버튼 찾기
    const notificationBtn = document.querySelector(
        'button[data-notification-bell-widget]'
    );

    if (!notificationBtn) {
        console.log('🔔 Floating Notification 버튼을 찾지 못했습니다.');
        return;
    }

    // 팝업 열기
    notificationBtn.click();
    console.log('🔔 Notifications 열기');

    // Buy all 클릭
    setTimeout(() => {

        const allButtons = [...document.querySelectorAll("button")]
            .filter(btn =>
                btn.textContent.trim().toLowerCase() === "buy all" &&
                !btn.disabled
            );

        if (allButtons.length === 0) {
            console.log("📦 Buy all 버튼 없음");
        }

        allButtons.forEach(btn => {
            btn.click();
            console.log("✅ Buy all 클릭");
        });

        // 팝업 닫기
        setTimeout(() => {
            notificationBtn.click();
            console.log("🔔 Notifications 닫기");
        }, 500);

    }, 500);
};


// 10초 뒤 시작 + 1분마다 반복
setTimeout(autoClickAllButtons, 10000);
setInterval(autoClickAllButtons, 1 * 60 * 1000);

